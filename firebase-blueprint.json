{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, credentials, and role state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatarUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["apprentice", "training_provider", "employer_mentor", "programme_admin"] },
        "currentJobTitle": { "type": "string" },
        "targetJobTitle": { "type": "string" },
        "organizationName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "fullName", "email", "role"]
    },
    "UserCapability": {
      "title": "UserCapability",
      "description": "User skill capability and verification level",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "skillId": { "type": "string" },
        "skillName": { "type": "string" },
        "category": { "type": "string" },
        "currentLevel": { "type": "string" },
        "confidenceScore": { "type": "number" },
        "evidenceStatus": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "skillId", "skillName"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Public probe document for checking Firestore connectivity",
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile and role settings"
    },
    "/users/{userId}/capabilities/{capabilityId}": {
      "schema": "UserCapability",
      "description": "Stores user capability records"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Stores user notifications"
    },
    "/test/{testId}": {
      "schema": "ConnectionTest",
      "description": "Used by getFromServer to verify Firestore connectivity"
    }
  }
}
