rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public test probe collection for connectivity check
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // Nested user capabilities
      match /capabilities/{capabilityId} {
        allow read, write: if isOwner(userId) && isValidId(capabilityId);
      }

      // Nested user notifications
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) && isValidId(notificationId);
      }
    }
  }
}
